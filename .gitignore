# ============================================
#  IGNORAR — datos personales y locales
# ============================================

# Claude Code (memoria local, settings personales)
.claude/

# Documentos de soporte (no son codigo)
doc/
*.pdf
*.docx

# ============================================
#  IGNORAR — build artifacts .NET
# ============================================
src/**/bin/
src/**/obj/
tests/**/bin/
tests/**/obj/
*.dll
*.exe
*.pdb
*.lscache
publish/

# ============================================
#  IGNORAR — archivos sensibles (NUNCA subir)
# ============================================

# Variables de entorno
.env
.env.*
!.env.example

# Connection strings y secretos
appsettings.*.local.json
appsettings.Production.json
secrets.json

# Certificados y claves
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
*.csr

# ============================================
#  IGNORAR — datos en tiempo de ejecucion
# ============================================

# SQLite — BD local del cliente (no debe subirse al repo)
*.db
*.db-shm
*.db-wal
*.sqlite

# Carpeta de datos persistentes de Docker (volumen ./data en la raiz del proyecto)
/data/

# Logs
*.log
logs/

# ============================================
#  IGNORAR — IDE / sistema operativo
# ============================================
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
